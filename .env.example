# computer-use-mcp configuration. Copy this file to .env and adjust as needed.
# All values have sensible defaults; you can leave .env empty for a normal setup.

# --- Screen / coordinate grounding ---
# Longest side (px) to downscale screenshots to before sending to Claude.
# Claude bills vision in 28x28 patches: tokens = ceil(w/28) * ceil(h/28).
# From a 1920x1080 primary that works out to, per screenshot:
#   1792 -> 1792x1008 = 2304 tokens   (sharpest small text; ~2x the cost)
#   1260 -> 1260x700  = 1125 tokens   (default; patch-aligned, no wasted sliver)
#   1036 -> 1036x581  =  777 tokens   (-31%; small UI text starts to suffer)
#    896 ->  896x504  =  576 tokens   (-49%; icons/layout only)
# Keep the long edge <= 2576px: images returned inside a tool_result are REJECTED
# rather than downscaled when they exceed the model's limit.
COMPUTER_USE_MAX_DIM=1260

# Round each axis down to a whole 28px patch so no tokens are spent on a partial
# patch row/column. Costs <28px per axis and saves ~6% of every screenshot. 1=on.
COMPUTER_USE_PATCH_ALIGN=1

# Default monitor to capture & control. 1 = primary, 2.. = other monitors,
# 0 = ALL screens at once (the whole virtual desktop). The agent can also pass
# `monitor=<index>` per call, and use action="monitors" to detect the setup.
COMPUTER_USE_MONITOR=1

# JPEG/PNG. This does NOT change token cost — Claude bills by pixel dimensions,
# not file size, so a JPEG and a PNG of the same screenshot cost exactly the same.
# What it changes is payload size (~977KB -> ~141KB here), which cuts stdio and
# upload latency. PNG keeps text crisp; JPEG artifacts can hurt small-text OCR.
COMPUTER_USE_IMAGE_FORMAT=png

# --- Token economy ---
# Skip the screenshot when less than this fraction of pixels materially changed
# since the last image we sent, and reply "screen unchanged" instead. A repeat
# screenshot is the costliest thing this server can do: it is re-sent as history
# on every later turn. Note a real desktop never yields two identical frames
# (clock, caret, hover), hence a threshold rather than an equality check. 0=off.
COMPUTER_USE_CHANGE_THRESHOLD=0.002

# Never suppress more than this many screenshots in a row — forces a resync so
# the model cannot fly blind if it lost the earlier image to context compaction.
COMPUTER_USE_MAX_SKIPS=6

# --- Pacing / safety ---
# Seconds pyautogui pauses after every action. Higher = easier to interrupt & watch.
COMPUTER_USE_PAUSE=0.15

# Global panic hotkey that hard-kills the server (and thus all automation).
COMPUTER_USE_PANIC_HOTKEY=ctrl+alt+q

# Show the always-on-top STOP button + current-action overlay. 1=on, 0=off.
COMPUTER_USE_OVERLAY=1

# Mouse-move duration (seconds) so the cursor glides like a human instead of teleporting.
COMPUTER_USE_MOVE_DURATION=0.4

# Stand down (close overlay + release panic hotkey) after this many idle seconds.
# The agent can also stand down immediately with action="stop". 0 = never auto-stop.
COMPUTER_USE_IDLE_STOP=30
